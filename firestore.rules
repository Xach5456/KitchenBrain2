rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to read any user profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Following/Followers (Server-Authoritative)
    match /following/{userId}/userFollowing/{otherUserId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    
    match /followers/{userId}/userFollowers/{otherUserId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
    
    // Notifications (New Nested Path)
    match /notifications/{userId}/user_notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
    }

    // Legacy Notifications (Top-level)
    match /notifications/{notificationId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == resource.data.receiverId;
      allow create: if request.auth != null;
    }

    // Chats
    match /chat_rooms/{roomId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.user1Id || request.auth.uid == resource.data.user2Id);
      allow write: if request.auth != null;
    }

    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow write: if request.auth != null;
      
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null;
      }
    }
    
    // Recipes
    match /recipes/{recipeId} {
      function existingRecipeOwnerId() {
        return resource.data.authorId != null ? resource.data.authorId : resource.data.createdBy;
      }

      function incomingRecipeOwnerId() {
        return request.resource.data.authorId != null ? request.resource.data.authorId : request.resource.data.createdBy;
      }

      function isRecipeOwner() {
        return request.auth != null && existingRecipeOwnerId() == request.auth.uid;
      }

      function keepsRecipeOwner() {
        return incomingRecipeOwnerId() == existingRecipeOwnerId();
      }

      function isSocialRecipeUpdate() {
        return request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy', 'likes', 'likesCount', 'savedBy', 'saves', 'comments', 'updatedAt']);
      }

      allow read: if request.auth != null;
      allow create: if request.auth != null && incomingRecipeOwnerId() == request.auth.uid;
      allow update: if (isRecipeOwner() && keepsRecipeOwner()) || isSocialRecipeUpdate();
      allow delete: if isRecipeOwner();

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }

      match /ratings/{ratingUserId} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null
          && ratingUserId == request.auth.uid
          && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && ratingUserId == request.auth.uid;
      }
    }
    
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
