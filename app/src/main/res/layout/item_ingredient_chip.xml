<?xml version="1.0" encoding="utf-8"?>
<!-- Individual ingredient chip with selection state -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:layout_margin="4dp"
    android:gravity="center_vertical"
    android:background="@drawable/bg_ingredient_unselected"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Ingredient Icon -->
    <TextView
        android:id="@+id/textIngredientIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:text="🍅"
        android:textSize="20sp"
        android:gravity="center" />

    <!-- Ingredient Name -->
    <TextView
        android:id="@+id/textIngredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Tomato"
        android:textSize="16sp"
        android:textColor="@color/text_primary" />

    <!-- Selection Indicator (checkmark) -->
    <View
        android:id="@+id/selectionIndicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/ic_check_circle"
        android:visibility="gone" />

</LinearLayout>
