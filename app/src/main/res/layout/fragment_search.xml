<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_primary">

    <!-- Top section: Categories and Search Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Scroll for categories -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_margin="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- Main Category -->
                <LinearLayout
                    android:id="@+id/mainCategoryLayout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/category_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/mainCategoryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/main_category"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <LinearLayout
                        android:id="@+id/mainIngredientsContainer"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <CheckBox
                            android:id="@+id/checkbox_flour"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/flour"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_eggs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/eggs"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_sugar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sugar"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_oil"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/oil"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Vegetables Category -->
                <LinearLayout
                    android:id="@+id/vegetableCategoryLayout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/category_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/vegetableCategoryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/vegetables_category"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:padding="16dp" />

                    <LinearLayout
                        android:id="@+id/vegetableCategoryCheckBoxContainer"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <CheckBox
                            android:id="@+id/checkbox_potato"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/potato"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_onion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/onion"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_carrot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/carrot"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_pepper"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pepper"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Fruits Category -->
                <LinearLayout
                    android:id="@+id/fruitCategoryLayout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/category_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/fruitCategoryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fruits_category"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:padding="16dp" />

                    <LinearLayout
                        android:id="@+id/fruitCategoryCheckBoxContainer"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <CheckBox
                            android:id="@+id/checkbox_apple"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/apple"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_banana"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/banana"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_orange"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/orange_fruit"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_pear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/pear"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Dairy Products Category -->
                <LinearLayout
                    android:id="@+id/dairyCategoryLayout"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/category_background"
                    android:padding="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/dairyCategoryTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dairy_category"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:padding="16dp" />

                    <LinearLayout
                        android:id="@+id/dairyCategoryCheckBoxContainer"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:paddingTop="8dp">

                        <CheckBox
                            android:id="@+id/checkbox_milk"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/milk"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_sour_cream"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sour_cream"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_cottage_cheese"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cottage_cheese"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                        <CheckBox
                            android:id="@+id/checkbox_cheese"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/cheese"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <!-- Find Recipe Button -->
        <Button
            android:id="@+id/searchRecipeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="@string/search_recipes_button"
            android:textSize="18sp"
            android:textColor="@color/on_primary_color"
            android:background="@drawable/rounded_button_with_shadow" />

    </LinearLayout>

    <!-- RecyclerView for displaying search results -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp" />

</LinearLayout>