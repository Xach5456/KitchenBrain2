<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Profile Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/imageViewProfile"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_default_avatar"
                android:scaleType="centerCrop"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guest User"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="guest@example.com"
                    android:textColor="@color/text_secondary_blue"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Guest Mode Indicator -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guest Mode Active"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:background="@drawable/category_background"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <!-- Guest Mode Features Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limited features available in guest mode. Sign in to access all features."
            android:textSize="14sp"
            android:textColor="@color/text_secondary_blue"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:gravity="center" />

        <!-- Login Button -->
        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign In"
            android:textColor="@color/on_primary_color"
            android:background="@drawable/button_style"
            android:drawableLeft="@drawable/ic_profile"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp" />

        <!-- Guest Mode Features List -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Available in Guest Mode:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Browse recipes\n• Search ingredients\n• View public content\n• Watch videos"
            android:textSize="14sp"
            android:textColor="@color/text_secondary_blue"
            android:padding="12dp"
            android:background="@drawable/rounded_container"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Restricted in Guest Mode:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Save recipes\n• Follow users\n• Send messages\n• Upload content\n• Personalized features"
            android:textSize="14sp"
            android:textColor="@color/warning_color"
            android:padding="12dp"
            android:background="@drawable/rounded_container"
            android:layout_marginBottom="8dp" />

    </LinearLayout>

</ScrollView>