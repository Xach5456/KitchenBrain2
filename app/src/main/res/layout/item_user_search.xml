<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground">

    <!-- Profile Picture - Circular like Instagram -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/imageProfile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_profile_placeholder"
        android:contentDescription="Profile picture"
        app:civ_border_width="0dp"
        app:civ_border_color="@color/divider_color" />

    <!-- User Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- Username - Bold like Instagram -->
        <TextView
            android:id="@+id/textUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Email/Full Name -->
        <TextView
            android:id="@+id/textEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="user@example.com"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Recipe Count -->
        <TextView
            android:id="@+id/textRecipeCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 recipes"
            android:textSize="12sp"
            android:textColor="@color/text_tertiary"
            android:maxLines="1"
            android:layout_marginTop="1dp" />

    </LinearLayout>

    <!-- Buttons Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <!-- Main Action Button (Follow/Message) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonFollow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Follow"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:minWidth="80dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/primary_blue"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Unfollow Button (Shown only when Message is visible) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonUnfollow"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:text="Unfollow"
            android:textAllCaps="false"
            android:textSize="13sp"
            android:minWidth="80dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:cornerRadius="8dp"
            app:backgroundTint="@color/md_secondary_light"
            android:textColor="@color/white"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

</LinearLayout>
