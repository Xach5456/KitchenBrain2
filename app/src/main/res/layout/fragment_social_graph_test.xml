<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 Social Graph Validation Tests"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:gravity="center"
            android:padding="16dp" />

        <TextView
            android:id="@+id/textTestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ready to run tests"
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center"
            android:padding="8dp" />

        <!-- Run Button -->
        <Button
            android:id="@+id/btnRunAllTests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶️ RUN ALL TESTS"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:layout_margin="16dp"
            android:padding="16dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#CCCCCC"
            android:layout_margin="16dp" />

        <!-- Test Results -->
        <LinearLayout
            android:id="@+id/layoutTestResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:minHeight="400dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Test results will appear here..."
                android:textSize="14sp"
                android:textColor="#999999"
                android:gravity="center"
                android:padding="32dp" />

        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ Edit TEST_USER_B_ID in code before running"
            android:textSize="12sp"
            android:textColor="#FF9800"
            android:gravity="center"
            android:padding="16dp" />

    </LinearLayout>

</ScrollView>
