<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Glowing Aura: Optimized for both themes -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/logoGlow"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:src="@drawable/photo_5228760239639826910_y"
        android:alpha="0"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/CircleAppearanceOverlay"
        app:layout_constraintTop_toTopOf="@id/appLogo"
        app:layout_constraintBottom_toBottomOf="@id/appLogo"
        app:layout_constraintStart_toStartOf="@id/appLogo"
        app:layout_constraintEnd_toEndOf="@id/appLogo" />

    <!-- Main Logo -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/appLogo"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:src="@drawable/photo_5228760239639826910_y"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:scaleX="1.3"
        android:scaleY="1.3"
        android:padding="2dp"
        app:strokeWidth="2dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:shapeAppearanceOverlay="@style/CircleAppearanceOverlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/appName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="24dp"/>

    <!-- App name: Uses theme-aware color -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="32sp"
        android:fontFamily="sans-serif-black"
        android:textColor="?attr/colorPrimary"
        android:alpha="0"
        android:translationY="30dp"
        app:layout_constraintTop_toBottomOf="@id/appLogo"
        app:layout_constraintBottom_toTopOf="@id/subTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:letterSpacing="0.05"
        android:textAllCaps="true"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/subTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cooking made simple"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:alpha="0"
        android:translationY="20dp"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/appName"
        app:layout_constraintBottom_toTopOf="@id/progressBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"/>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="180dp"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:alpha="0"
        android:progressTint="?attr/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/subTitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>