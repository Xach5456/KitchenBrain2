<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Night mode. -->
    <style name="Base.Theme.KitchenBrain" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Customize your dark theme here. -->
        <item name="colorPrimary">@color/md_primary_dark</item>
        <item name="colorOnPrimary">@color/md_on_primary_dark</item>
        <item name="colorSecondary">@color/md_secondary_dark</item>
        <item name="colorOnSecondary">@color/md_on_secondary_dark</item>

        <!-- 🔥 КРИТИЧЕСКИЕ ЦВЕТА ДЛЯ MaterialAlertDialogBuilder -->
        <item name="colorSurface">@color/md_surface_dark</item>
        <item name="colorOnSurface">@color/md_on_surface_dark</item>
        <item name="colorOnBackground">@color/md_on_surface_dark</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant_dark</item>
        <item name="android:colorBackground">@color/md_background_dark</item>

        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest_dark</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low_dark</item>
        <item name="colorSurfaceContainer">@color/md_surface_container_dark</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high_dark</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest_dark</item>

        <!-- Bridge for compatibility -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>

        <!-- Material 3 Dialog Theme -->
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>

        <item name="android:statusBarColor">@color/md_background_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/md_background_dark</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="materialButtonStyle">@style/Premium.Button</item>
        <item name="materialCardViewStyle">@style/Premium.Card</item>
        <item name="textInputStyle">@style/Premium.TextInput</item>
    </style>

    <style name="Theme.KitchenBrain" parent="Base.Theme.KitchenBrain" />
</resources>
