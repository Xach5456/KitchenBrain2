<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.KitchenBrain" parent="Theme.Material3.Light.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">@color/md_primary_light</item>
        <item name="colorOnPrimary">@color/md_on_primary_light</item>
        <item name="colorSecondary">@color/md_secondary_light</item>
        <item name="colorOnSecondary">@color/md_on_secondary_light</item>

        <!-- 🔥 КРИТИЧЕСКИЕ ЦВЕТА ДЛЯ MaterialAlertDialogBuilder -->
        <item name="colorSurface">@color/md_surface_light</item>
        <item name="colorOnSurface">@color/md_on_surface_light</item>
        <item name="colorOnBackground">@color/md_on_surface_light</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant_light</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant_light</item>
        <item name="android:colorBackground">@color/md_background_light</item>

        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest_light</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low_light</item>
        <item name="colorSurfaceContainer">@color/md_surface_container_light</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high_light</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest_light</item>

        <!-- Bridge for compatibility -->
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>

        <!-- Material 3 Dialog Theme -->
        <item name="materialAlertDialogTheme">@style/AlertDialogTheme</item>

        <item name="android:statusBarColor">@color/md_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/md_background_light</item>
        <item name="android:windowLightNavigationBar">true</item>

        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="fontFamily">@font/inter_regular</item>
        <item name="materialButtonStyle">@style/Premium.Button</item>
        <item name="materialCardViewStyle">@style/Premium.Card</item>
        <item name="textInputStyle">@style/Premium.TextInput</item>
    </style>

    <style name="Theme.KitchenBrain" parent="Base.Theme.KitchenBrain" />

    <style name="Theme.App.Splash" parent="Theme.KitchenBrain">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
    </style>
</resources>
