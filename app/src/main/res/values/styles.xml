<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ExpandedTitleStyle">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="RoundedCornersTopOnly">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    
    <style name="RoundedCornersBottomOnly">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">24dp</item>
        <item name="cornerSizeBottomRight">24dp</item>
    </style>
    
    <!-- Button Styles -->
    <style name="Widget.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_primary_normal</item>
        <item name="android:textColor">@color/on_primary_color</item>
    </style>
    
    <style name="Widget.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/button_secondary_border</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    
    <style name="Widget.Button.Success" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/button_success_normal</item>
        <item name="android:textColor">@color/on_secondary_color</item>
    </style>
</resources>