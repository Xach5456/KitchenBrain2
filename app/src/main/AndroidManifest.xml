<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- CRITICAL FIX: Add VIBRATE permission for haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KitchenBrain">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LoginActivity"
            android:label="KitchenBrain"
            android:theme="@style/Theme.KitchenBrain"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".MainActivity"
            android:label="Main"
            android:theme="@style/Theme.KitchenBrain"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <activity
            android:name=".RegisterActivity"
            android:label="Register"
            android:theme="@style/Theme.KitchenBrain"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WaitingForConfirmationActivity"
            android:label="Email Confirmation"
            android:theme="@style/Theme.KitchenBrain"
            android:exported="true" />

        <activity
            android:name=".RecipeDetailActivity"
            android:exported="false"
            android:label="@string/recipe_detail_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.KitchenBrain" />
    </application>

</manifest>